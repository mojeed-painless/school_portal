#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Verifying staged files and running related unit tests..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
  echo "No staged changes detected."
  exit 0
fi

STAGED_SRC=$(printf '%s\n' "$STAGED_FILES" | grep '^src/' | grep -vE '\.test\.(js|jsx)$' || true)
STAGED_TESTS=$(printf '%s\n' "$STAGED_FILES" | grep -E '^src/.*\.test\.(js|jsx)$' || true)

if [ -n "$STAGED_SRC" ] && [ -z "$STAGED_TESTS" ]; then
  echo "❌ Atomic commit policy violation: source changes in src/ must be paired with a test file in the same commit."
  echo "Changed source files:"
  printf '%s\n' "$STAGED_SRC"
  exit 1
fi

if [ -n "$STAGED_SRC" ]; then
  echo "Running related tests for staged source files..."
  npm run test -- --related $STAGED_SRC --run
fi
